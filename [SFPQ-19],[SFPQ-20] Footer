    font-size: 38px;
    font-weight: 800;
    color: #064e3b;
    margin-bottom: 14px;
    letter-spacing: -0.5px;
}

.contact-info p {
    color: #6b7280;
    font-size: 15px;
    line-height: 1.75;
    margin-bottom: 36px;
}

.info-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.info-item {
    display: flex;
    align-items: center;
    gap: 16px;
}

.info-icon {
    width: 46px;
    height: 46px;
    background: #d1fae5;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #059669;
    font-size: 18px;
    flex-shrink: 0;
}

.info-item strong {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 2px;
}

.info-item span {
    font-size: 14px;
    color: #6b7280;
}

