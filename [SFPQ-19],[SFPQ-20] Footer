    width: 100%;
    padding: 12px 14px 12px 40px;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: white;
    transition: border 0.3s;
    outline: none;
    color: #111827;
}

.input-wrap input:focus { border-color: #10b981; }

