.contact-form-box {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    padding: 44px;
}

.success-box {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 0;
    gap: 12px;
}

.success-box i {
    font-size: 56px;
