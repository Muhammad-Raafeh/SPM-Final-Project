    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #f0fdf4;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .header {
        background: #ffffff;
        padding: 16px 0;
        position: sticky;
        top: 0;
        z-index: 1000;
        border-bottom: 1px solid #d1fae5;
        box-shadow: 0 1px 30px rgba(16, 185, 129, 0.08);
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    /* LOGO */
    .logo {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #064e3b;
        font-size: 22px;
        font-weight: 700;
    }

    .logo-icon {
        width: 42px;
        height: 42px;
        background: linear-gradient(135deg, #10b981, #059669);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
    }

    .logo strong {
        color: #10b981;
    }

    /* NAVBAR */
    .navbar {
        display: flex;
        gap: 32px;
    }

    .navbar a {
        text-decoration: none;
        color: #374151;
        font-weight: 500;
        font-size: 15px;
        position: relative;
        padding-bottom: 4px;
        transition: color 0.3s;
    }

    .navbar a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: #10b981;
        border-radius: 2px;
        transition: width 0.3s;
    }

    .navbar a:hover { color: #10b981; }
    .navbar a:hover::after { width: 100%; }

    /* BUTTON */
    .btn-signup {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #10b981;
        color: white;
        padding: 11px 24px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    .btn-signup:hover {
        background: #059669;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    }

    @media (max-width: 768px) {
        .navbar { display: none; }
        .logo span { font-size: 18px; }
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #f0fdf4;
        overflow-x: hidden;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .hero {
        padding: 100px 0 80px;
        position: relative;
        overflow: hidden;
        background: #f0fdf4;
    }

    .hero-bg-shape {
        position: absolute;
        top: -200px;
        right: -200px;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(16,185,129,0.12), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .hero-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 60px;
    }

    /* BADGE */
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #d1fae5;
        color: #065f46;
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 24px;
        border: 1px solid #a7f3d0;
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* HEADING */
    h1 {
        font-size: 54px;
        font-weight: 800;
        color: #064e3b;
        line-height: 1.15;
        margin-bottom: 20px;
        letter-spacing: -1px;
    }

    h1 span {
        color: #10b981;
        position: relative;
    }

    h1 span::after {
        content: '';
        position: absolute;
        bottom: 4px;
        left: 0;
        width: 100%;
        height: 4px;
        background: #a7f3d0;
        border-radius: 2px;
        z-index: -1;
    }

    .hero-content p {
        font-size: 17px;
        color: #4b5563;
        line-height: 1.75;
        margin-bottom: 36px;
        max-width: 460px;
    }

    /* BUTTONS */
    .hero-actions {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 48px;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #10b981;
        color: white;
        padding: 14px 28px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 8px 25px rgba(16,185,129,0.35);
        transition: all 0.3s;
    }

    .btn-primary:hover {
        background: #059669;
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(16,185,129,0.4);
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #065f46;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        transition: gap 0.3s;
    }

    .btn-ghost:hover { gap: 12px; }
    .btn-ghost i { color: #10b981; font-size: 20px; }

    /* STATS */
    .hero-stats {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .stat strong {
        display: block;
        font-size: 22px;
        font-weight: 800;
        color: #064e3b;
    }

    .stat span {
        font-size: 13px;
        color: #6b7280;
    }

    .stat-divider {
        width: 1px;
        height: 36px;
        background: #d1fae5;
    }

    /* VISUAL CARD */
    .hero-visual {
        position: relative;
        display: flex;
        justify-content: center;
    }

    .hero-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        width: 300px;
        box-shadow: 0 20px 60px rgba(16,185,129,0.15);
        border: 1px solid #d1fae5;
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 20px;
    }

    .card-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .card-dot.red { background: #f87171; }
    .card-dot.yellow { background: #fbbf24; }
    .card-dot.green { background: #10b981; }

    .card-label {
        margin-left: auto;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
    }

    .card-amount {
        font-size: 36px;
        font-weight: 800;
        color: #064e3b;
        margin-bottom: 6px;
    }

    .card-change {
        font-size: 13px;
        color: #10b981;
        font-weight: 600;
        margin-bottom: 24px;
    }

    .card-bars {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        height: 80px;
    }

    .bar {
        flex: 1;
        background: #d1fae5;
        border-radius: 4px 4px 0 0;
        transition: background 0.3s;
    }

    .bar.active { background: #10b981; }

    /* FLOAT CARD */
    .hero-float-card {
        position: absolute;
        bottom: -10px;
        left: -20px;
        background: white;
        border-radius: 12px;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 600;
        color: #064e3b;
        box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        border: 1px solid #d1fae5;
        animation: float 3s ease-in-out infinite;
    }

    .hero-float-card i {
        color: #10b981;
        font-size: 18px;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    @media (max-width: 768px) {
        .hero-inner { grid-template-columns: 1fr; text-align: center; }
        h1 { font-size: 36px; }
        .hero-visual { display: none; }
        .hero-actions { justify-content: center; }
        .hero-stats { justify-content: center; }
    }

